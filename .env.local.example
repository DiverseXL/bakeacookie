# bakeacookie environment configuration
# Copy this to .env.local and customize for your environment

# RPC endpoint — defaults to Cookie Chain's public RPC
# Override for local validator:
# NEXT_PUBLIC_RPC_URL=http://localhost:8899
# Override for Solana devnet:
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_RPC_URL=https://rpc.cookiescan.io

# Recipe Book program address (do not change unless you're testing a fork)
NEXT_PUBLIC_RECIPE_BOOK_PROGRAM_ID=56Vj61zFW4hHV6wdjnisrHtVwWDqyjixjpBgnoRJvzxL
